# Copy to .env.local and fill in what you have. Every service is optional:
# without it the app falls back to a local stand-in so you can still run it.
#
# Before putting this on the internet, set at least ADMIN_TOKEN and
# TELEGRAM_WEBHOOK_SECRET. A production build refuses admin actions and
# Telegram updates without them.

# --- AI gauge reading + alert agent (Claude) ---
# Without a key, readings use MOCK mode (only the /demo page can be "read").
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Database (Supabase) ---
# Without these, data is stored in a JSON file under DATA_DIR.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=gauge-photos
DATA_DIR=.data

# --- Telegram alerts ---
# Without a token, outgoing messages are logged and kept in the local outbox.
TELEGRAM_BOT_TOKEN=
# Required once a bot token is set: the secret Telegram sends in
# X-Telegram-Bot-Api-Secret-Token (pass it to setWebhook). Without it, anyone
# who finds the webhook URL could confirm readings and trigger alerts.
TELEGRAM_WEBHOOK_SECRET=
# Bot username (without @), used for the "subscribe" link on the setup page.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Public URL of this app, used for dashboard links in Telegram messages.
PUBLIC_BASE_URL=

# --- Admin ---
# Required in production. Protects editing stations, confirming readings, and
# viewing gauge photos and volunteer names.
ADMIN_TOKEN=

# --- Scheduled work ---
# Set to enable POST /api/cron, which runs reminders, the PAGASA check,
# message retries and photo retention. Point a scheduler at it, or run
# `npm run job:pagasa -- --loop 5` as a second process instead.
CRON_SECRET=
# Gauge photos are deleted after this many days (0 keeps them forever).
PHOTO_RETENTION_DAYS=30

# --- PAGASA advisory check ---
# A URL returning either JSON {"warning":"yellow|orange|red|none","text":"..."}
# or an HTML/text bulletin that is scanned for YELLOW/ORANGE/RED warnings.
PAGASA_ADVISORY_URL=
